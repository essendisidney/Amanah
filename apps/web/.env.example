# Amanah Web — Environment Variables
# Copy to `.env.local` for local development.
# Never commit real secrets.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Amanah

# -----------------------------------------------------------------------------
# Supabase (public — safe for browser)
# Get these from: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# -----------------------------------------------------------------------------
# Supabase (server-only — NEVER expose to the browser)
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# -----------------------------------------------------------------------------
# Auth providers (configure in Supabase Dashboard → Authentication → Providers)
# -----------------------------------------------------------------------------
# 1) Auth → URL Configuration
#    Site URL: http://localhost:3000  (production: your Vercel URL)
#    Redirect URLs: {SITE_URL}/auth/callback
#
# 2) Google OAuth
#    Enable Google; set Client ID + Secret from Google Cloud Console
#    Authorized redirect URI in Google:
#      https://{PROJECT_REF}.supabase.co/auth/v1/callback
#
# 3) Phone OTP
#    Enable Phone provider; configure Twilio (or supported SMS provider)
#    Test with E.164 numbers, e.g. +254712345678

# -----------------------------------------------------------------------------
# Optional: analytics / monitoring (Phase 2)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# CRON_SECRET=                                 # Edge Function cron auth (optional)
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_SKIP_WEBSERVER=1                  # when app already running

# -----------------------------------------------------------------------------
# Phase 3 — Payments & delivery
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=simulated                     # simulated | mpesa | bank
REQUIRE_REAL_PROVIDERS=false                   # true = no simulated payment fallbacks
ALLOW_SIMULATED_IN_PROD=false                  # set true only for staging-like prod previews
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://your-project.supabase.co/functions/v1/payments-mpesa
# MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# BANK_API_KEY=
# BANK_API_URL=https://bank-psp.example.com/v1
# BANK_WEBHOOK_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=Amanah <noreply@yourdomain.com>
# TWILIO_ACCOUNT_SID=                          # product SMS (invites/reminders)
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

