# Amanah Web — Environment Variables
# Copy to `.env.local` for local development.
# Never commit real secrets.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Amanah

# -----------------------------------------------------------------------------
# Supabase (public — safe for browser)
# Get these from: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# -----------------------------------------------------------------------------
# Supabase (server-only — NEVER expose to the browser)
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# -----------------------------------------------------------------------------
# Auth providers (configure in Supabase Dashboard → Authentication → Providers)
# -----------------------------------------------------------------------------
# 1) Auth → URL Configuration
#    Site URL: http://localhost:3000  (production: your Vercel URL)
#    Redirect URLs: {SITE_URL}/auth/callback
#
# 2) Google OAuth
#    Enable Google; set Client ID + Secret from Google Cloud Console
#    Authorized redirect URI in Google:
#      https://{PROJECT_REF}.supabase.co/auth/v1/callback
#
# 3) Phone OTP (Kenya) — Taifa SMS + otp_codes (Creda / Savr pattern)
#    Does NOT require Supabase Phone / Twilio for login.
#    TAIFA_API_KEY=                          # required in production (Next.js OTP)
#    TAIFA_SENDER_ID=SIDNET
#    SMS_BYPASS=true                         # local only — logs OTP; blocked in production
#    Accepts 0712… or +254712…
#    Product reminder SMS uses these same Vercel TAIFA_* keys via
#    /api/cron/dispatch (no separate Edge Taifa secret required).

# -----------------------------------------------------------------------------
# Optional: analytics / monitoring (Phase 2)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# CRON_SECRET=                                 # Edge Function cron auth (optional)
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_SKIP_WEBSERVER=1                  # when app already running

# -----------------------------------------------------------------------------
# Phase 3 — Payments & delivery
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=simulated                     # simulated | mpesa | bank | paystack
REQUIRE_REAL_PROVIDERS=false                   # true = no simulated payment fallbacks
ALLOW_SIMULATED_IN_PROD=true                   # keep true until Daraja secrets are live
# Daraja secrets belong on Edge (supabase secrets set), not required in Next.js:
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://vzpnixfqkvovbniaoudx.supabase.co/functions/v1/payments-mpesa
# MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# See docs/PHASE_9.md
# BANK_API_KEY=
# BANK_API_URL=https://bank-psp.example.com/v1
# BANK_WEBHOOK_SECRET=
# BANK_ALERT_WEBHOOK_SECRET=                   # /api/webhooks/bank-alerts (x-amanah-webhook-secret)
# Paystack (Next.js — wallet / sadaka / tips). See docs/PAYSTACK.md
# PAYSTACK_SECRET_KEY=sk_test_...              # or sk_live_...
# NEXT_PUBLIC_APP_URL=https://amanah-liart.vercel.app
# Webhook URL in Paystack dashboard: https://amanah-liart.vercel.app/api/webhooks/paystack

# RESEND_API_KEY=
# EMAIL_FROM=Amanah <noreply@yourdomain.com>
# TWILIO_ACCOUNT_SID=                          # optional product SMS / WhatsApp fallback
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # WhatsApp (sandbox or live)

# -----------------------------------------------------------------------------
# Phase 13–14 — Tawarruq partner + SMS providers (Edge notify-dispatch)
# -----------------------------------------------------------------------------
# TAWARRUQ_PARTNER_API_URL=https://partner-bank.example.com/v1
# TAWARRUQ_PARTNER_API_KEY=
# TAWARRUQ_WEBHOOK_SECRET=                     # Edge webhook header X-Tawarruq-Webhook-Secret
# USSD_CALLBACK_SECRET=                        # required on /api/ussd when set (X-USSD-Secret)
# AT_USSD_SHORTCODE=*123#                      # optional serviceCode match
# AT_USERNAME=                                 # Africa’s Talking fallback (SMS + USSD)
# AT_API_KEY=
# AT_SMS_SHORTCODE=                            # or AT_SENDER_ID for SMS from
# SMS_PROVIDER=taifa                           # taifa (default) | auto | africastalking | twilio
# CRON_SECRET=                                 # Vercel /api/cron/dispatch + Edge crons

