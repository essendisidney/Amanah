{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@jamiya/web",
  "crons": [
    {
      "path": "/api/cron/dispatch?job=reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/dispatch?job=notify",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/dispatch?job=collections",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/dispatch?job=tawarruq",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/dispatch?job=sadaka",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/dispatch?job=auto-fines",
      "schedule": "15 6 * * *"
    }
  ]
}
